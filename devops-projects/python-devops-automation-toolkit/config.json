{
    "application": {
        "name": "Python DevOps Automation Toolkit",
        "version": "1.0.0",
        "environment": "development"
    },
    "system_monitor": {
        "enabled": true,
        "cpu_threshold": 80,
        "memory_threshold": 85,
        "disk_threshold": 90
    },
    "network_checker": {
        "enabled": true,
        "host": "example.com",
        "port": 443,
        "timeout": 3
    },
    "website_checker": {
        "enabled": true,
        "url": "https://example.com",
        "timeout": 5,
        "expected_status": 200
    },
    "log_analyzer": {
        "enabled": true,
        "file_path": "sample_logs/application.log",
        "top_errors": 5
    },
    "command_runner": {
        "enabled": true,
        "commands": [
            "whoami",
            "hostname",
            "uptime",
            "disk",
            "memory",
            "kernel",
            "network",
            "ports"
        ],
        "timeout": 5
    },
    "reporting": {
        "output_directory": "reports",
        "format": "json"
    }
}